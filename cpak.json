{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "ProtonUp-Qt",
  "description": "Install and manage Wine and Proton compatibility tools.",
  "version": "2.15.1",
  "image": "ghcr.io/containerpak/protonup-qt@sha256:9e5c5fcb3442e21f72de5a552da7361f7d1bd2f5470330a7377b0978531547b6",
